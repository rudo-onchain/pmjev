MODE=paper
ASSETS=btc,eth,sol,hype
CHECKPOINTS=60,150,180,210,240,270,280
ENTRY_CHECKPOINTS=150,180,240
EXIT_CHECKPOINTS=180,210,240,270,280
JEV_ENABLED=true
JEV_TRADE=false
GBM_TRADE=true
TREND_GBM_TRADE=false
JEV_MARKET_VARIANT=true
JEV_TIMEOUT_S=1.5
TYPESAFE_API_KEY=
# DeepSeek is hard-blocked outside MODE=paper.
DEEPSEEK_ENABLED=false
DEEPSEEK_TRADE=false
DEEPSEEK_DIRECT_ENABLED=false
DEEPSEEK_DIRECT_TRADE=false
DEEPSEEK_TIMEOUT_S=2.5
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
EDGE=0.03
# Skip entries when abs(model P(UP) - Polymarket midpoint) exceeds this value.
MAX_MODEL_MARKET_GAP=0.25
# Fallback only. The per-market Gamma feeSchedule is used when available.
FEE_PEAK=0.018
DB_URL=sqlite:///pmjev.sqlite
# Production: copy the Supabase direct or session-pooler connection string into DB_URL.
# Use the session pooler on port 5432 when the runtime cannot reach the direct IPv6 host.
# Keep this separate so the one-time importer can target Postgres before cutover.
SUPABASE_DB_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_CONNECT_TIMEOUT_S=5
# Blank derives HTTP_TIMEOUT_S + the longest enabled predictor timeout + 1s grace.
CHECKPOINT_BUDGET_S=
DASHBOARD_STARTING_BALANCE_USD=100
CHAINLINK_TOPIC=crypto_prices_twap_sixty
STAKE_USD=5
DAILY_LOSS_LIMIT_USD=25
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=

# PolyBolt activates automatically after all three POLY_API_* values are set.
REFERENCE_FEED=auto
POLYBOLT_WS_URL=wss://ws-live-v2.polymarket.com/ws
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_PRIVATE_KEY=
POLY_WALLET=
LIVE_TRADING_ENABLED=false
# Global cap for three simultaneous $10 positions. Keep the arming switch false.
MAX_NOTIONAL_USD=30
LIVE_MAX_TRADE_USD=10
LIVE_MIN_SHARES=5
CONSECUTIVE_LOSS_LIMIT=8
LOSS_PAUSE_SECONDS=3600
MAX_DRAWDOWN_USD=100
RISK_RESET_AT=0
STOP_FILE=STOP
REFERENCE_STALE_SECONDS=10
JEV_ERROR_WINDOW_SECONDS=1800
JEV_ERROR_RATE_LIMIT=0.20
